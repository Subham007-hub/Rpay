# Get these from https://dashboard.razorpay.com (switch to Test Mode) -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret

# Settings -> Webhooks -> create a webhook, copy the secret you set there
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Guardrail policy - the merchant's stated bounds for what the AI agent may do
MAX_ORDER_VALUE_RUPEES=15000
MAX_DISCOUNT_PERCENT=20
